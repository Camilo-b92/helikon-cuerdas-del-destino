# Reglas de formato para que todos escribamos igual.
# Compatible con VS Code (extensión EditorConfig), JetBrains y Sublime.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
