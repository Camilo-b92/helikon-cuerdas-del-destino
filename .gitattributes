# Normaliza los finales de línea: LF en el repositorio,
# lo que corresponda al sistema en la copia de trabajo.
* text=auto eol=lf

# Binarios: que Git no intente convertirlos ni mostrar diffs
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.mp4  binary
*.webp binary
*.woff  binary
*.woff2 binary
